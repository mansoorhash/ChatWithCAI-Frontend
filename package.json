{
  "name": "frontend",
  "version": "0.1.0",
  "description": "The React frontend for ChatWithCAI's automatic multi-provider LLM router.",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite --host",
    "start": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "validate:api-catalog": "node scripts/validate-api-catalog.js",
    "validate:auth-md": "node scripts/validate-auth-md.js",
    "prebuild": "npm run generate:sitemap && npm run validate:api-catalog && npm run validate:auth-md",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
